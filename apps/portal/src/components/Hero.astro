---
import Terminal from './Terminal.astro';
---

<section class="px-5 pt-16 pb-16 sm:px-6 sm:pt-24 sm:pb-20">
  <div class="mx-auto grid max-w-5xl grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-10">
    <!-- 左栏：标题 + 定位 -->
    <div class="lg:col-span-7">
      <p class="animate-fade-up font-mono text-[13px] text-accent" style="animation-delay: 0.05s">
        ~/watermore
      </p>

      <h1
        class="animate-fade-up mt-5 text-6xl font-semibold leading-[0.95] tracking-tighter text-ink sm:text-7xl lg:text-8xl"
        style="animation-delay: 0.12s"
      >
        WaterMore
      </h1>

      <p
        class="animate-fade-up mt-7 max-w-prose text-xl leading-relaxed text-ink-muted sm:text-2xl"
        style="animation-delay: 0.22s"
      >
        你好，我是 WaterMore。我做 web 产品——写代码，也做设计。
      </p>

      <p
        class="animate-fade-up mt-4 max-w-prose text-base leading-relaxed text-ink-faint"
        style="animation-delay: 0.3s"
      >
        这里是我的个人主页，偶尔更新。想聊天的话，欢迎去
        <a
          href="https://chat.loopv.net"
          class="text-accent underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent-hover"
        >聊天室</a
        >坐坐。
      </p>

      <a
        href="#about"
        class="animate-fade-up mt-10 inline-flex items-center gap-2 font-mono text-sm text-ink-muted transition-colors hover:text-ink"
        style="animation-delay: 0.42s"
      >
        了解更多
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <!-- 右栏：终端（不对称下沉） -->
    <div class="animate-fade-up lg:col-span-5 lg:pt-10" style="animation-delay: 0.32s">
      <Terminal />
    </div>
  </div>
</section>
