    <p class="font-mono text-xs text-ink-faint">
      © {year} WaterMore · 内容来自 GitHub 仓库的 Markdown 文件
    </p>
    <div class="flex items-center gap-6">
      <a href="https://loopv.net" class="text-xs text-ink-muted transition-colors hover:text-ink">门户</a>
      <a href="https://chat.loopv.net" class="text-xs text-ink-muted transition-colors hover:text-ink">聊天室</a>
    </div>
  </div>
</footer>
