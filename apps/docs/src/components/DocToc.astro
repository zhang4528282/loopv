---
// 目录（TOC）：容器在无 JS 时通过 CSS 保持隐藏（display:none），
// 脚本扫描 .doc-body 里带 id 的 h2/h3 后生成锚点列表，再 .is-on 显示。
// 带一条滚动高亮（IntersectionObserver），逻辑很短，不做复杂处理。
---

<aside
  id="toc-wrap"
  class="order-1 mb-10 max-h-72 overflow-y-auto rounded-xl border border-line bg-surface p-4 shadow-soft lg:col-span-4 lg:col-start-9 lg:row-start-1 lg:mb-0 lg:max-h-[calc(100vh-7rem)] lg:sticky lg:top-20 lg:self-start lg:p-5"
>
  <p class="toc-label">本页目录</p>
  <nav id="toc-list" class="mt-3" aria-label="本页目录"></nav>
</aside>

<script>
  const wrap = document.getElementById("toc-wrap");
  if (wrap) {
    const list = document.getElementById("toc-list");
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>(".doc-body h2[id], .doc-body h3[id]"),
    );

    if (!list || headings.length === 0) {
      wrap.remove();
    } else {
      const links: HTMLAnchorElement[] = headings.map((h) => {
        const a = document.createElement("a");
        a.href = `#${h.id}`;
        a.textContent = h.textContent ?? "";
        a.dataset.id = h.id;
        a.classList.add("toc-a");
        if (h.tagName === "H3") a.classList.add("lv3");
        list.appendChild(a);
        return a;
      });

      wrap.classList.add("is-on");

      let currentId = "";
      const setActive = (id: string) => {
        if (id === currentId) return;
        currentId = id;
        links.forEach((a) => a.classList.toggle("is-active", a.dataset.id === id));
      };

      // 随滚动更新高亮
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive((entry.target as HTMLElement).id);
          }
        },
        { rootMargin: "-15% 0px -75% 0px", threshold: 0 },
      );
      headings.forEach((h) => observer.observe(h));

      // 点击跳转后立刻高亮，不等滚动回调
      links.forEach((a) =>
        a.addEventListener("click", () => {
          if (a.dataset.id) setActive(a.dataset.id);
        }),
      );

      setActive(headings[0].id);
    }
  }
</script>
