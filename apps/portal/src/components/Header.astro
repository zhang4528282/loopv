---
// 顶部导航 — 简洁，暖纸感半透明
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="WaterMore 首页">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-[7px] bg-accent font-serif text-[15px] font-bold text-white"
        aria-hidden="true"
      >W</span>
      <span class="text-[15px] font-semibold tracking-tight text-ink">WaterMore</span>
    </a>

    <nav class="flex items-center gap-5 sm:gap-7">
      <a href="#about" class="text-sm text-ink-muted transition-colors hover:text-ink">关于</a>
      <a href="https://docs.loopv.net" class="hidden text-sm text-ink-muted transition-colors hover:text-ink sm:inline">
        文档
      </a>
      <a href="https://chat.loopv.net" class="hidden text-sm text-ink-muted transition-colors hover:text-ink sm:inline">
        聊天室
      </a>
      <a
        href="https://chat.loopv.net"
        class="rounded-lg bg-accent px-3.5 py-1.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
      >
        进入聊天室
      </a>
    </nav>
  </div>
</header>
