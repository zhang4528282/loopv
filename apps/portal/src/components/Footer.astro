---
const year = new Date().getFullYear();
---

<footer class="border-t border-line px-5 py-10 sm:px-6">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs text-ink-faint">© {year} WaterMore</p>
    <div class="flex items-center gap-6">
      <a href="https://docs.loopv.net" class="text-xs text-ink-muted transition-colors hover:text-ink">
        文档
      </a>
      <a href="https://chat.loopv.net" class="text-xs text-ink-muted transition-colors hover:text-ink">
        聊天室
      </a>
      <span class="font-mono text-xs text-ink-faint">Astro · Cloudflare</span>
    </div>
  </div>
</footer>
