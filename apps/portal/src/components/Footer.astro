---
// Minimal footer
const year = new Date().getFullYear();
---

<footer class="section border-t border-border px-6 py-8">
  <div class="mx-auto max-w-2xl flex flex-col items-center gap-2 text-center sm:flex-row sm:justify-between sm:text-left">
    <p class="font-mono text-xs text-ink-muted">
      &copy; {year} <span class="text-ink">loopv.net</span>
    </p>
    <p class="font-mono text-xs text-ink-muted">
      <span class="text-brand" aria-hidden="true">$ exit</span>
      <span class="ml-2">Thanks for stopping by.</span>
    </p>
  </div>
</footer>
