---
const terminalTitle = "watermore@loopv: ~";
---

<div class="terminal w-full">
  <div class="terminal-bar">
    <div class="terminal-dot r"></div>
    <div class="terminal-dot y"></div>
    <div class="terminal-dot g"></div>
    <span class="terminal-title">{terminalTitle}</span>
  </div>
  <div class="terminal-body" id="terminal-body"></div>
</div>

<script>
  const lines = [
    { prompt: 'watermore@loopv:~$', cmd: 'whoami', output: 'WaterMore', delay: 500 },
    { prompt: 'watermore@loopv:~$', cmd: 'cat ~/about', output: '写代码，做设计，维护 loopv.net', delay: 650 },
    { prompt: 'watermore@loopv:~$', cmd: 'ls ./sites', output: 'loopv.net  chat.loopv.net', delay: 550 },
  ];

  const body = document.getElementById('terminal-body');
  if (body) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function makeLine() {
      const line = document.createElement('div');
      line.className = 'terminal-line';
      body.appendChild(line);
      return line;
    }

    function el(cls, text) {
      const span = document.createElement('span');
      span.className = cls;
      if (text !== undefined) span.textContent = text;
      return span;
    }

    function renderStatic() {
      for (const l of lines) {
        const line = makeLine();
        line.appendChild(el('terminal-prompt', l.prompt + ' '));
        if (l.cmd) line.appendChild(el('terminal-command', l.cmd));
        if (l.output) {
          const out = makeLine();
          out.appendChild(el('terminal-output', l.output));
        }
      }
      const last = makeLine();
      last.appendChild(el('terminal-prompt', 'watermore@loopv:~$'));
      last.appendChild(el('terminal-cursor'));
    }

    if (prefersReduced) {
      renderStatic();
    } else {
      function typeInto(span, text, speed) {
        return new Promise((resolve) => {
          let n = 0;
          const timer = setInterval(() => {
            span.textContent += text[n];
            n++;
            if (n >= text.length) {
              clearInterval(timer);
              resolve();
            }
          }, speed);
        });
      }

      (async () => {
        await new Promise((r) => setTimeout(r, 400));
        for (const l of lines) {
          const line = makeLine();
          line.appendChild(el('terminal-prompt', l.prompt + ' '));
          if (l.cmd) {
            const cmd = el('terminal-command');
            const cursor = el('terminal-cursor');
            line.appendChild(cmd);
            line.appendChild(cursor);
            await typeInto(cmd, l.cmd, 55);
            cursor.remove();
            await new Promise((r) => setTimeout(r, l.delay));
          }
          if (l.output) {
            const out = makeLine();
            out.appendChild(el('terminal-output', l.output));
            await new Promise((r) => setTimeout(r, l.delay));
          }
        }
        const last = makeLine();
        last.appendChild(el('terminal-prompt', 'watermore@loopv:~$'));
        last.appendChild(el('terminal-cursor'));
      })();
    }
  }
</script>
