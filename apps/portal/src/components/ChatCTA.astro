---
// Chat room CTA card
---

<section class="section px-6 py-20">
  <div class="mx-auto max-w-2xl">
    <!-- CTA Card -->
    <a
      href="https://chat.loopv.net"
      class="group relative block overflow-hidden rounded-xl border border-border bg-surface p-8 transition-all duration-300 hover:border-brand hover:bg-surface-hover sm:p-10"
    >
      <!-- Hover glow effect -->
      <div
        class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        style="background: radial-gradient(ellipse at center, rgba(108,92,231,0.08) 0%, transparent 70%);"
        aria-hidden="true"
      ></div>

      <!-- Border glow on hover -->
      <div
        class="pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        style="box-shadow: inset 0 0 40px rgba(108,92,231,0.08);"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 flex flex-col gap-4">
        <!-- Terminal-style label -->
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-brand" aria-hidden="true">$ ssh chat@loopv.net</span>
          <span class="inline-flex items-center rounded-full border border-brand/30 bg-brand/10 px-2.5 py-0.5 font-mono text-[10px] font-medium text-brand tracking-wide uppercase">
            Coming Soon
          </span>
        </div>

        <!-- Title -->
        <h2 class="text-2xl font-bold text-ink sm:text-3xl">
          Join the <span class="text-brand">Chat Room</span>
        </h2>

        <!-- Description -->
        <p class="max-w-md text-ink-muted leading-relaxed">
          A real-time space to hang out, share ideas, and connect. Currently under construction — stay tuned.
        </p>

        <!-- CTA arrow -->
        <div class="mt-2 flex items-center gap-2 font-mono text-sm text-brand transition-all duration-300 group-hover:gap-3 group-hover:text-brand-light">
          <span>chat.loopv.net</span>
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </div>
      </div>
    </a>
  </div>
</section>
